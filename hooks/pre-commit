#!/bin/sh
# Ruff-Check vor jedem Commit. Aktivieren mit: git config core.hooksPath hooks

poetry run ruff check .
if [ $? -ne 0 ]; then
    echo "Ruff hat Probleme gefunden. Commit abgebrochen."
    exit 1
fi

poetry run pip-audit
if [ $? -ne 0 ]; then
    echo "pip-audit hat Schwachstellen gefunden. Commit abgebrochen."
    exit 1
fi
